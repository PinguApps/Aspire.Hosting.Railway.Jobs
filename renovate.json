{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dotnet tool install -g Aspire\\.Cli --version (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.Railway\\.Jobs/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/",
        "/^eng/Test-LiveRailwayDeployment\\.ps1$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "\"sdk\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)AGENTS\\.md$/"
      ],
      "matchStrings": [
        "Target Aspire version:\\s*`(?<currentValue>[^`]+)`"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Hosting",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "Requires \\.NET 10, Aspire (?<currentValue>\\d+\\.\\d+\\.\\d+),"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver",
      "depNameTemplate": "Aspire.Hosting"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^eng/Test-LiveRailwayDeployment\\.ps1$/"
      ],
      "matchStrings": [
        "<PackageReference Include=\"(?<depName>Aspire\\.Hosting\\.(?:AppHost|Dotnet))\" Version=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.Railway\\.Jobs/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>Aspire\\.Hosting\\.Dotnet|PinguApps\\.Aspire\\.Hosting\\.Railway)\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/install\\.md$/"
      ],
      "matchStrings": [
        "\"PinguApps\\.Aspire\\.Hosting\\.Railway\"\\s*:\\s*\"(?<currentValue>[^\"]+)\"",
        "`PinguApps\\.Aspire\\.Hosting\\.Railway` (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver",
      "depNameTemplate": "PinguApps.Aspire.Hosting.Railway"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "Aspire.Cli",
        "/^Aspire\\.Hosting(?:\\.|$)/"
      ],
      "groupName": "aspire monorepo",
      "groupSlug": "aspire-monorepo"
    },
    {
      "description": "Update installed skills as whole managed dependencies.",
      "matchFileNames": [
        "**/.agents/skills/**"
      ],
      "enabled": false
    }
  ]
}
